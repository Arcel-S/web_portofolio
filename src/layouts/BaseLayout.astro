---
import Navbar from '@components/common/Navbar.astro';
import Footer from '@components/common/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const { 
  title, 
  description = "Marcel Kevin Togap Siagian (Marcel Siregar / Marcel Siagian) - Fullstack, Backend & Frontend Developer, Programmer AI, dan Mahasiswa Developer Teknik Informatika ITERA.", 
  image = "https://res.cloudinary.com/djielecvv/image/upload/v1784817492/123140054_photo_230628_nqubr5.jpg",
  canonicalURL = Astro.url.href
} = Astro.props;

const siteName = "Marcel Kevin Togap Siagian | Fullstack & Backend Developer | Programmer";
const keywords = "Marcel, Marcel Portofolio, Portofolio Marcel, Marcel Developer, Marcel Fullstack, Marcel Kevin Togap Siagian, Marcel Siregar, Marcel Siagian, developer marcel, marcel ai developer, fullstack developer indonesia, software engineer itera, portfolio marcel, web developer lampung, mktsportofolio.web.id";

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://mktsportofolio.web.id/#person",
      "name": "Marcel Kevin Togap Siagian",
      "givenName": "Marcel",
      "familyName": "Siagian",
      "alternateName": [
        "Marcel",
        "Marcel Siregar",
        "Marcel Siagian",
        "Marcel Developer",
        "Marcel Portofolio",
        "Portofolio Marcel",
        "Marcel Fullstack",
        "Marcel AI Developer"
      ],
      "url": "https://mktsportofolio.web.id/",
      "image": image,
      "jobTitle": "Fullstack & AI Developer",
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Institut Teknologi Sumatera (ITERA)"
      },
      "sameAs": [
        "https://github.com/Arcel-S",
        "https://www.linkedin.com/in/marcelsiregar/"
      ],
      "email": "mailto:marcellsiregar1204@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bandar Lampung",
        "addressCountry": "ID"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://mktsportofolio.web.id/#website",
      "url": "https://mktsportofolio.web.id/",
      "name": "Portofolio Marcel Kevin Togap Siagian | Fullstack & AI Developer",
      "description": description,
      "publisher": {
        "@id": "https://mktsportofolio.web.id/#person"
      },
      "inLanguage": "id-ID"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Marcel Kevin Togap Siagian" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Structured Data (JSON-LD) for Google Personal Brand & SEO -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <div>
      <Navbar />
      <slot />
    </div>
    <Footer />
  </body>
</html>

