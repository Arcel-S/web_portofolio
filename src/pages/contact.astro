---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | NAMA.DEV">
  <main class="flex-grow z-10 pt-[120px] pb-section-gap px-grid-margin flex flex-col items-center justify-center min-h-[calc(100vh-140px)]">
    <div class="w-full max-w-2xl bg-surface-card-light dark:bg-surface-card-dark border border-ink-black dark:border-ink-border-dark p-stack-lg shadow-hard">
      
      <!-- Terminal Header -->
      <div class="border-b border-ink-black dark:border-ink-border-dark pb-stack-md mb-stack-lg flex justify-between items-center">
        <h1 class="font-mono text-sm text-ink-black dark:text-ink-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-terracotta inline-block"></span>
          marcell@marcel.dev:~/contact$
        </h1>
        <div class="flex gap-2">
          <div class="w-3 h-3 border border-ink-black dark:border-ink-border-dark rounded-full"></div>
          <div class="w-3 h-3 border border-ink-black dark:border-ink-border-dark rounded-full"></div>
          <div class="w-3 h-3 border border-ink-black dark:border-ink-border-dark bg-ink-black dark:bg-ink-white rounded-full"></div>
        </div>
      </div>

      <!-- Form Contact Terminal Style -->
      <form class="space-y-stack-lg flex flex-col">
        <div class="relative group">
          <label class="font-mono text-xs text-ink-gray dark:text-ink-slate absolute -top-4 left-0 transition-all group-focus-within:text-accent-terracotta" for="name">
            NAME=
          </label>
          <input 
            class="w-full bg-transparent border-0 border-b border-ink-black dark:border-ink-border-dark px-0 py-2 font-mono text-sm text-ink-black dark:text-ink-white focus:ring-0 focus:border-accent-terracotta transition-colors placeholder:text-ink-slate/70 dark:placeholder:text-ink-slate/70" 
            id="name" 
            name="name" 
            placeholder='"enter_your_name"' 
            required 
            type="text"
          />
        </div>

        <div class="relative group mt-6">
          <label class="font-mono text-xs text-ink-gray dark:text-ink-slate absolute -top-4 left-0 transition-all group-focus-within:text-accent-terracotta" for="email">
            EMAIL=
          </label>
          <input 
            class="w-full bg-transparent border-0 border-b border-ink-black dark:border-ink-border-dark px-0 py-2 font-mono text-sm text-ink-black dark:text-ink-white focus:ring-0 focus:border-accent-terracotta transition-colors placeholder:text-ink-slate/70 dark:placeholder:text-ink-slate/70" 
            id="email" 
            name="email" 
            placeholder='"enter_your_email@domain.com"' 
            required 
            type="email"
          />
        </div>

        <div class="relative group mt-6">
          <label class="font-mono text-xs text-ink-gray dark:text-ink-slate absolute -top-4 left-0 transition-all group-focus-within:text-accent-terracotta" for="message">
            MESSAGE_PAYLOAD=
          </label>
          <textarea 
            class="w-full bg-transparent border-0 border-b border-ink-black dark:border-ink-border-dark px-0 py-2 font-mono text-sm text-ink-black dark:text-ink-white focus:ring-0 focus:border-accent-terracotta transition-colors placeholder:text-ink-slate/70 dark:placeholder:text-ink-slate/70 resize-none mt-2" 
            id="message" 
            name="message" 
            placeholder="&gt; _start_typing_here..." 
            required 
            rows="4"
          ></textarea>
        </div>

        <div class="pt-stack-md flex justify-end">
          <button 
            class="px-6 py-3 bg-brand-terracotta text-surface-card-light font-mono text-sm border border-ink-black dark:border-ink-border-dark shadow-hard hover:shadow-hard-hover hover:-translate-y-1 hover:-translate-x-1 transition-all rounded-sm flex items-center gap-2 group" 
            type="submit"
          >
            [ EXECUTE ] &rarr;
          </button>
        </div>
      </form>

      <!-- Terminal Status Footer -->
      <div class="mt-stack-lg pt-stack-md border-t border-ink-black/20 dark:border-ink-border-dark flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="font-mono text-xs text-ink-gray dark:text-ink-slate">
          &gt; STATUS: LISTENING ON PORT 443
        </div>
        <div class="flex gap-4">
          <span class="px-2 py-1 border border-ink-border-light dark:border-ink-border-dark rounded font-mono text-xs text-ink-gray dark:text-ink-slate">PGP: AVAILABLE</span>
          <span class="px-2 py-1 border border-accent-sage-dark bg-accent-sage-dark/10 rounded font-mono text-xs text-accent-sage-dark">SYS: ONLINE</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
