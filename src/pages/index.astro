---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';
import Timeline from '@components/experience/Timeline.astro';
import { getCollection, getEntry } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.filter((p) => p.data.featured);

const workHistoryEntry = await getEntry('experience', 'work-history');
const experienceData = workHistoryEntry ? workHistoryEntry.data : [];
---

<BaseLayout title="Marcel Kevin Togap Siagian | Fullstack & AI Developer">
  <main class="flex-grow pt-[80px]">
    
    <!-- 0. Hero Section -->
    <section id="hero">
      <Hero />
    </section>

    <!-- 1. About Section (Profil & Identity Developer - Paling Atas setelah Hero) -->
    <section id="about" class="px-grid-margin py-section-gap bg-surface-container-low dark:bg-surface-charcoal-dim border-b border-ink-black/20 dark:border-ink-border-dark scroll-mt-20">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-gutter relative items-start">
        
        <!-- Left Column (Profile Photo & Identity) -->
        <div class="md:col-span-5 flex flex-col gap-stack-lg">
          <div class="w-full aspect-[4/5] bg-surface-cream-dim dark:bg-surface-card-dark border border-ink-black/20 dark:border-ink-border-dark shadow-hard overflow-hidden relative rounded-2xl group">
            <img 
              src="https://res.cloudinary.com/djielecvv/image/upload/v1784817492/123140054_photo_230628_nqubr5.jpg" 
              alt="Marcel Kevin Togap Siagian - Technical Profile Photo" 
              class="w-full h-full object-cover object-center filter grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500 scale-100 group-hover:scale-105"
              loading="eager"
            />
          </div>
          <div class="flex flex-col gap-stack-sm border-t border-ink-black/10 dark:border-ink-border-dark pt-stack-md">
            <h3 class="font-serif text-3xl font-bold text-ink-black dark:text-ink-white">Marcel Kevin Togap Siagian</h3>
            <p class="font-mono text-sm text-ink-gray dark:text-ink-slate">7th Semester CS Student &amp; Fullstack/AI Developer</p>
            <div class="flex gap-stack-sm mt-stack-sm flex-wrap">
              <span class="font-mono text-xs px-2.5 py-1 border border-ink-border-light dark:border-ink-border-dark rounded-md bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">BANDAR LAMPUNG, ID</span>
              <span class="font-mono text-xs px-2.5 py-1 border border-ink-border-light dark:border-ink-border-dark rounded-md bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">SEM 7 ITERA</span>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="md:col-span-7 md:col-start-7 flex flex-col gap-section-gap">
          <section class="flex flex-col gap-stack-lg">
            <span class="font-mono text-xs text-brand-terracotta uppercase tracking-wider block">01 / PHILOSOPHY &amp; PROFILE</span>
            <h2 class="font-serif text-4xl lg:text-5xl leading-tight uppercase tracking-tight text-ink-black dark:text-ink-white font-bold">
              BUILDING <br/>
              <span class="italic text-primary">BACKEND &amp; AI</span> <br/>
              WITH INTENT.
            </h2>
            <div class="h-px w-full bg-ink-black dark:bg-ink-border-dark"></div>
            <div class="font-sans text-base lg:text-lg flex flex-col gap-stack-md max-w-2xl text-ink-gray dark:text-ink-slate leading-relaxed">
              <p>
                Saya adalah mahasiswa semester akhir (Semester 7) Teknik Informatika di Institut Teknologi Sumatera (ITERA). Memiliki minat mendalam pada pengembangan sistem backend, arsitektur database, analisis data, serta integrasi solusi Artificial Intelligence.
              </p>
              <p>
                Selain berkuliah, saya aktif menjadi Asisten Laboratorium &amp; Asisten Tutorial di ITERA untuk 8 mata kuliah utama ilmu komputer, serta berhasil meraih penghargaan <strong>Top 10% Scholar Nasional</strong> dari 2.000+ pendaftar pada program Beasiswa AI Developer AI4IMPACT.
              </p>
            </div>
          </section>

          <!-- Technical Competencies -->
          <section class="flex flex-col gap-stack-lg">
            <h3 class="font-serif text-2xl font-bold border-b border-ink-black dark:border-ink-border-dark pb-stack-sm text-ink-black dark:text-ink-white">
              Technical Competencies
            </h3>
            <div class="grid grid-cols-2 gap-stack-md font-mono text-sm text-ink-black dark:text-ink-white">
              <ul class="flex flex-col gap-stack-sm">
                <li>&gt; Node.js &amp; Express APIs</li>
                <li>&gt; PostgreSQL &amp; MongoDB</li>
                <li>&gt; Machine Learning &amp; AI Chatbot</li>
              </ul>
              <ul class="flex flex-col gap-stack-sm">
                <li>&gt; Tableau Data Visualization</li>
                <li>&gt; Python Data Analysis</li>
                <li>&gt; Cloud Computing (Alibaba)</li>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </section>

    <!-- 2. Featured Projects Section (Selected Works) -->
    <section id="projects" class="px-grid-margin py-section-gap border-b border-ink-black/20 dark:border-ink-border-dark scroll-mt-20">
      <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-end mb-grid-margin pb-stack-sm border-b-2 border-ink-black dark:border-ink-border-dark">
          <div>
            <span class="font-mono text-xs text-brand-terracotta uppercase tracking-wider block mb-1">02 / SELECTED WORKS</span>
            <h2 class="font-serif text-3xl lg:text-4xl text-ink-black dark:text-ink-white font-bold">Featured Projects &amp; AI Systems</h2>
          </div>
          <span class="font-mono text-xs text-ink-gray dark:text-ink-slate">TOTAL: {projects.length} PROJECTS</span>
        </div>

        {featuredProjects.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-grid-margin">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-grid-margin">
            <!-- Project Card 1: Verobox AI -->
            <article class="bg-surface-card-light dark:bg-surface-card-dark border border-ink-black/20 dark:border-ink-border-dark rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all group flex flex-col overflow-hidden">
              <div class="aspect-video border-b border-ink-black/10 dark:border-ink-border-dark overflow-hidden relative bg-surface-cream-dim dark:bg-surface-charcoal flex flex-col items-center justify-center p-6 text-center">
                <span class="font-mono text-xs text-brand-terracotta uppercase font-bold mb-2">TOP 10% NATIONAL AI SCHOLARSHIP</span>
                <h4 class="font-serif text-2xl font-bold text-ink-black dark:text-ink-white">Verobox AI Chatbot</h4>
              </div>
              <div class="p-stack-lg flex-grow flex flex-col">
                <span class="font-mono text-xs text-brand-sage uppercase font-bold tracking-wider mb-1">AI / Fullstack</span>
                <h3 class="font-serif text-xl font-bold text-ink-black dark:text-ink-white mb-stack-sm">Verobox – Intelligent Conversational Bot</h3>
                <p class="font-sans text-sm text-ink-gray dark:text-ink-slate mb-stack-md flex-grow">Interactive AI chatbot system developed during AI4IMPACT Scholarship 5.0, selected in Top 10% out of 2,000+ national applicants.</p>
                <div class="flex flex-wrap gap-2 mb-stack-md">
                  <span class="font-mono text-xs border border-ink-border-light dark:border-ink-border-dark px-2.5 py-1 rounded-md bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Python</span>
                  <span class="font-mono text-xs border border-ink-border-light dark:border-ink-border-dark px-2.5 py-1 rounded-md bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">AI Chatbot</span>
                  <span class="font-mono text-xs border border-ink-border-light dark:border-ink-border-dark px-2.5 py-1 rounded-md bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Node.js</span>
                </div>
                <a class="font-mono text-xs text-brand-terracotta font-bold hover:underline flex items-center gap-2 mt-auto border-t border-ink-black/10 dark:border-ink-border-dark pt-stack-sm" href="https://app.smojo.org/arcel71/Verobox" target="_blank" rel="noopener noreferrer">
                  Launch Live Demo &rarr;
                </a>
              </div>
            </article>

            <!-- Project Card 2: Global News Portal -->
            <article class="bg-surface-card-light dark:bg-surface-card-dark border border-ink-black/20 dark:border-ink-border-dark rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all group flex flex-col overflow-hidden">
              <div class="aspect-video border-b border-ink-black/10 dark:border-ink-border-dark overflow-hidden relative bg-surface-cream-dim dark:bg-surface-charcoal flex flex-col items-center justify-center p-6 text-center">
                <span class="font-mono text-xs text-brand-sage uppercase font-bold mb-2">LIVE DEPLOYED ON VERCEL</span>
                <h4 class="font-serif text-2xl font-bold text-ink-black dark:text-ink-white">Global News Portal</h4>
              </div>
              <div class="p-stack-lg flex-grow flex flex-col">
                <span class="font-mono text-xs text-brand-sage uppercase font-bold tracking-wider mb-1">Fullstack / REST API</span>
                <h3 class="font-serif text-xl font-bold text-ink-black dark:text-ink-white mb-stack-sm">Global News Portal – Worldwide News Aggregator</h3>
                <p class="font-sans text-sm text-ink-gray dark:text-ink-slate mb-stack-md flex-grow">Portal berita global yang mengintegrasikan NewsAPI untuk menampilkan berita terkini dari berbagai negara, populer post, serta filter kategori.</p>
                <div class="flex flex-wrap gap-2 mb-stack-md">
                  <span class="font-mono text-xs border border-ink-border-light dark:border-ink-border-dark px-2.5 py-1 rounded-md bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">JavaScript</span>
                  <span class="font-mono text-xs border border-ink-border-light dark:border-ink-border-dark px-2.5 py-1 rounded-md bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">NewsAPI</span>
                  <span class="font-mono text-xs border border-ink-border-light dark:border-ink-border-dark px-2.5 py-1 rounded-md bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Vercel</span>
                </div>
                <a class="font-mono text-xs text-brand-terracotta font-bold hover:underline flex items-center gap-2 mt-auto border-t border-ink-black/10 dark:border-ink-border-dark pt-stack-sm" href="https://uts-pemweb-123140054.vercel.app/" target="_blank" rel="noopener noreferrer">
                  Buka Portal Berita (Live Vercel) &rarr;
                </a>
              </div>
            </article>
          </div>
        )}
      </div>
    </section>

    <!-- 3. Experience & Academic Timeline Section -->
    <section id="experience" class="px-grid-margin py-section-gap bg-surface-container-low dark:bg-surface-charcoal-dim border-b border-ink-black/20 dark:border-ink-border-dark scroll-mt-20">
      <div class="max-w-7xl mx-auto">
        <div class="mb-section-gap max-w-4xl border-b border-ink-black dark:border-ink-border-dark pb-stack-lg">
          <span class="font-mono text-xs text-brand-terracotta uppercase tracking-wider block mb-1">03 / ACADEMIC &amp; WORK TIMELINE</span>
          <h2 class="font-serif text-4xl lg:text-5xl text-ink-black dark:text-ink-white mb-stack-md font-bold">
            Teaching Assistantships &amp; AI Grants
          </h2>
          <p class="font-sans text-lg text-ink-gray dark:text-ink-slate max-w-2xl">
            Chronological record of computer science assistantships at ITERA across 8 core courses, national AI developer scholarship awards, and software credentials.
          </p>
        </div>

        <!-- Render All 8 Assistantships Component -->
        <Timeline experienceList={experienceData} />

        <!-- Certifications Grid -->
        <div class="mt-section-gap border-t-2 border-ink-black dark:border-ink-border-dark pt-stack-lg">
          <h3 class="font-serif text-2xl font-bold text-ink-black dark:text-ink-white mb-stack-md">
            Official Certifications &amp; Credentials
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-grid-margin">
            <div class="p-stack-lg border border-ink-black dark:border-ink-border-dark bg-surface-card-light dark:bg-surface-card-dark rounded shadow-hard hover:shadow-hard-hover hover:-translate-y-1 hover:-translate-x-1 transition-all">
              <div class="font-mono text-xs font-bold text-brand-terracotta uppercase tracking-wider mb-2">ALIBABA CLOUD (2024 - 2026)</div>
              <h4 class="font-serif text-xl font-bold text-ink-black dark:text-ink-white mb-2">Alibaba Cloud Certified Developer</h4>
              <p class="font-sans text-sm text-ink-gray dark:text-ink-slate mb-3">Cloud computing architecture, containerization, and server deployment services.</p>
              <span class="font-mono text-xs px-2 py-1 border border-ink-border-light dark:border-ink-border-dark rounded bg-surface-cream dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Serial: ACCD0119700100012586</span>
            </div>

            <div class="p-stack-lg border border-ink-black/20 dark:border-ink-border-dark bg-surface-card-light dark:bg-surface-card-dark rounded-xl shadow-md hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col justify-between">
              <div>
                <div class="font-mono text-xs font-bold text-brand-sage uppercase tracking-wider mb-2">IBM / COGNITIVE CLASS (FEB 2025)</div>
                <h4 class="font-serif text-xl font-bold text-ink-black dark:text-ink-white mb-2">Python 101 for Data Science</h4>
                <p class="font-sans text-sm text-ink-gray dark:text-ink-slate mb-3">Data analysis, Pandas &amp; Numpy libraries, and algorithmic data processing in Python.</p>
              </div>
              <a href="https://collection.cloudinary.com/djielecvv/da0aced7428218358aa6aae1fda90980" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-mono text-xs text-brand-terracotta hover:underline font-bold mt-2">
                Lihat Sertifikat Cloudinary ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section (HRD & Recruiter Friendly Professional Form) -->
    <section id="contact" class="px-grid-margin py-[100px] flex flex-col items-center justify-center border-t border-ink-black/10 dark:border-ink-border-dark scroll-mt-20 bg-surface-container-low dark:bg-surface-charcoal-dim">
      <div class="w-full max-w-3xl bg-surface-card-light dark:bg-surface-card-dark border border-ink-black/20 dark:border-ink-border-dark p-8 md:p-12 shadow-xl rounded-2xl">
        
        <!-- Header Contact -->
        <div class="mb-10 text-center md:text-left flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-6 border-b border-ink-black/10 dark:border-ink-border-dark">
          <div>
            <span class="font-mono text-xs text-brand-terracotta font-bold uppercase tracking-wider block mb-2">04 / GET IN TOUCH</span>
            <h2 class="font-serif text-3xl md:text-4xl font-bold text-ink-black dark:text-ink-white leading-tight">
              Mari Berdiskusi &amp; Bekerja Sama
            </h2>
            <p class="font-sans text-sm md:text-base text-ink-gray dark:text-ink-slate mt-2 max-w-lg leading-relaxed">
              Apakah Anda rekruter, HRD, atau partner proyek? Kirimkan pesan singkat di bawah ini.
            </p>
          </div>
        </div>

        <!-- Status Message Alert -->
        <div id="form-status" class="hidden mb-6 p-4 rounded-xl font-sans text-sm font-semibold text-center transition-all"></div>

        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6 flex flex-col">
          <!-- Web3Forms Access Key for Direct Mail Dispatch -->
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="Pesan Baru Portofolio Website - Marcel.dev" />
          <input type="hidden" name="from_name" value="Marcel.dev Contact Form" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label class="font-sans text-xs font-bold text-ink-black dark:text-ink-white uppercase tracking-wider" for="name">
                Nama Lengkap / Instansi <span class="text-brand-terracotta">*</span>
              </label>
              <input 
                class="w-full bg-surface-cream-dim/60 dark:bg-surface-charcoal border border-ink-black/15 dark:border-ink-border-dark px-4 py-3.5 font-sans text-sm text-ink-black dark:text-ink-white focus:outline-none focus:border-brand-terracotta focus:ring-2 focus:ring-brand-terracotta/20 rounded-xl transition-all placeholder:text-ink-slate/40" 
                id="name" 
                name="name" 
                placeholder="Contoh: Tim HRD / Recruiter Company" 
                required 
                type="text"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class="font-sans text-xs font-bold text-ink-black dark:text-ink-white uppercase tracking-wider" for="email">
                Alamat Email <span class="text-brand-terracotta">*</span>
              </label>
              <input 
                class="w-full bg-surface-cream-dim/60 dark:bg-surface-charcoal border border-ink-black/15 dark:border-ink-border-dark px-4 py-3.5 font-sans text-sm text-ink-black dark:text-ink-white focus:outline-none focus:border-brand-terracotta focus:ring-2 focus:ring-brand-terracotta/20 rounded-xl transition-all placeholder:text-ink-slate/40" 
                id="email" 
                name="email" 
                placeholder="email.anda@perusahaan.com" 
                required 
                type="email"
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label class="font-sans text-xs font-bold text-ink-black dark:text-ink-white uppercase tracking-wider" for="message">
              Pesan / Penawaran Kerjasama <span class="text-brand-terracotta">*</span>
            </label>
            <textarea 
              class="w-full bg-surface-cream-dim/60 dark:bg-surface-charcoal border border-ink-black/15 dark:border-ink-border-dark px-4 py-3.5 font-sans text-sm text-ink-black dark:text-ink-white focus:outline-none focus:border-brand-terracotta focus:ring-2 focus:ring-brand-terracotta/20 rounded-xl transition-all placeholder:text-ink-slate/40 resize-none" 
              id="message" 
              name="message" 
              placeholder="Tuliskan peluang karir, tawaran proyek, atau pertanyaan Anda di sini..." 
              required 
              rows="4"
            ></textarea>
          </div>

          <div class="pt-4 flex flex-col md:flex-row justify-between items-center gap-6 border-t border-ink-black/10 dark:border-ink-border-dark">
            <div class="flex items-center gap-2 text-xs font-sans text-ink-gray dark:text-ink-slate">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Bandar Lampung, ID • <strong>Open for Hiring &amp; Fulltime Roles</strong></span>
            </div>
            <button 
              id="submit-btn"
              class="w-full md:w-auto px-8 py-3.5 bg-brand-terracotta text-white font-sans text-sm font-bold rounded-xl shadow-lg hover:bg-brand-terracotta/90 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2" 
              type="submit"
            >
              Kirim Pesan Sekarang &rarr;
            </button>
          </div>
        </form>

        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement | null;
          const statusDiv = document.getElementById('form-status');
          const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

          if (form) {
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Mengirim Pesan...';
              }
              if (statusDiv) {
                statusDiv.className = 'hidden';
              }

              const formData = new FormData(form);

              // Gunakan mailto langsung jika Web3Forms key belum dipasang
              const name = formData.get('name') as string;
              const email = formData.get('email') as string;
              const message = formData.get('message') as string;

              try {
                const response = await fetch('https://api.web3forms.com/submit', {
                  method: 'POST',
                  body: formData
                });
                const data = await response.json();

                if (data.success) {
                  if (statusDiv) {
                    statusDiv.className = 'mb-6 p-4 rounded-xl font-sans text-sm font-semibold text-center bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950 dark:text-emerald-200 dark:border-emerald-800';
                    statusDiv.textContent = '✅ Pesan Anda telah berhasil terkirim ke marcellsiregar1204@gmail.com!';
                  }
                  form.reset();
                } else {
                  throw new Error(data.message || 'Gagal mengirim');
                }
              } catch (err) {
                // Fallback ke Mailto jika API bermasalah
                const subject = encodeURIComponent(`Pesan Portofolio dari ${name}`);
                const body = encodeURIComponent(`Nama/Instansi: ${name}\nEmail: ${email}\n\nPesan:\n${message}`);
                window.location.href = `mailto:marcellsiregar1204@gmail.com?subject=${subject}&body=${body}`;
                
                if (statusDiv) {
                  statusDiv.className = 'mb-6 p-4 rounded-xl font-sans text-sm font-semibold text-center bg-blue-100 text-blue-800 border border-blue-300 dark:bg-blue-950 dark:text-blue-200 dark:border-blue-800';
                  statusDiv.textContent = '📧 Membuka aplikasi Email Anda untuk mengirim pesan ke marcellsiregar1204@gmail.com...';
                }
              } finally {
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = 'Kirim Pesan Sekarang →';
                }
              }
            });
          }
        </script>

      </div>
    </section>

  </main>
</BaseLayout>
