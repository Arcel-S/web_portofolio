---
interface Role {
  title: string;
  startDate: string;
  endDate?: string;
  type?: string;
  description: string[];
  keyAchievements?: string[];
  technologies: string[];
}

interface Item {
  company: string;
  location?: string;
  roles: Role[];
}

interface Props {
  experienceList: Item[];
}

const { experienceList } = Astro.props;
---

<div class="flex flex-col gap-grid-margin">
  {experienceList.map((item) => (
    <div class="bg-surface-card-light dark:bg-surface-card-dark border border-ink-black dark:border-ink-border-dark p-stack-lg shadow-hard">
      <!-- Header Perusahaan / Instansi -->
      <div class="border-b border-ink-black/20 dark:border-ink-border-dark pb-stack-sm mb-stack-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-2">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-brand-terracotta border border-ink-black inline-block"></span>
          <h3 class="font-serif text-2xl font-bold text-ink-black dark:text-ink-white">{item.company}</h3>
        </div>
        {item.location && (
          <span class="font-mono text-xs text-ink-gray dark:text-ink-slate border border-ink-border-light dark:border-ink-border-dark px-2 py-1 rounded bg-surface-cream dark:bg-surface-charcoal">
            📍 {item.location}
          </span>
        )}
      </div>

      <!-- Peran & Deskripsi (Vertical Cards Stack) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg">
        {item.roles.map((role) => (
          <div class="border border-ink-black/10 dark:border-ink-border-dark p-stack-md bg-surface-cream-dim dark:bg-surface-charcoal rounded flex flex-col justify-between hover:border-ink-black transition-colors">
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="font-mono text-[11px] text-brand-terracotta uppercase font-bold tracking-wider">{role.startDate} {role.endDate ? `— ${role.endDate}` : ''}</span>
                {role.type && (
                  <span class="font-mono text-[10px] px-1.5 py-0.5 border border-ink-border-light dark:border-ink-border-dark rounded text-ink-gray dark:text-ink-slate">
                    {role.type}
                  </span>
                )}
              </div>
              <h4 class="font-serif text-lg font-bold text-ink-black dark:text-ink-white mb-stack-sm leading-snug">
                {role.title}
              </h4>
              <ul class="space-y-1.5 font-sans text-xs text-ink-gray dark:text-ink-slate mb-stack-md">
                {role.description.map((desc) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-brand-terracotta text-sm leading-none">•</span>
                    <span>{desc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-1.5 border-t border-ink-black/10 dark:border-ink-border-dark pt-stack-sm mt-auto">
              {role.technologies.map((tech) => (
                <span class="px-2 py-0.5 border border-ink-border-light dark:border-ink-border-dark rounded font-mono text-[10px] text-ink-gray dark:text-ink-slate bg-surface-card-light dark:bg-surface-card-dark">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
