---
<section class="px-grid-margin py-section-gap border-b border-ink-black/20 dark:border-ink-border-dark">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-grid-margin items-start">
    <div class="lg:col-span-8 flex flex-col gap-stack-lg">
      <div class="inline-flex items-center gap-2 bg-brand-sage/10 border border-brand-sage/30 px-3 py-1 rounded w-fit">
        <span class="w-2 h-2 rounded-full bg-brand-sage animate-pulse"></span>
        <span class="font-mono text-xs text-brand-sage uppercase tracking-wider">Final Year Computer Science Student • ITERA</span>
      </div>
      <h1 class="font-serif text-4xl lg:text-6xl text-ink-black dark:text-ink-white font-bold leading-tight">
        Fullstack &amp; Backend Developer • Programmer &amp; AI Engineer.
      </h1>
      <p class="font-sans text-lg text-ink-gray dark:text-ink-slate max-w-2xl leading-relaxed">
        Mahasiswa Developer Teknik Informatika Institut Teknologi Sumatera (ITERA). Spesialis dalam pengembangan Backend API (Node.js/Express/PostgreSQL), Frontend modern, dan integrasi Artificial Intelligence.
      </p>
      <div class="mt-stack-sm flex flex-wrap items-center gap-4">
        <a href="#featured-projects" class="inline-flex items-center gap-2 bg-primary text-surface-card-light font-mono text-sm border border-ink-black dark:border-ink-border-dark px-6 py-4 hover:translate-x-[2px] hover:-translate-y-[2px] shadow-hard transition-all">
          [ Explore Work &amp; AI ] &rarr;
        </a>
        <a href="https://github.com/Arcel-S" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-transparent text-ink-black dark:text-ink-white font-mono text-sm border border-ink-black dark:border-ink-border-dark px-6 py-4 hover:bg-ink-black hover:text-ink-white dark:hover:bg-ink-white dark:hover:text-ink-black transition-all">
          GitHub Profile &rarr;
        </a>
      </div>
    </div>

    <!-- Live Status Card -->
    <div class="lg:col-span-4 lg:col-start-9 bg-surface-cream-dim dark:bg-surface-card-dark border border-ink-black dark:border-ink-border-dark p-stack-lg shadow-hard">
      <div class="flex items-center justify-between mb-stack-md border-b border-ink-black/20 dark:border-ink-border-dark pb-stack-sm">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-terracotta inline-block animate-ping"></span>
          <h3 class="font-mono text-xs text-ink-gray dark:text-ink-slate uppercase tracking-widest">Active Status</h3>
        </div>
        <span class="font-mono text-[10px] px-2 py-0.5 bg-brand-sage/20 text-brand-sage border border-brand-sage/40 rounded">OPEN TO WORK</span>
      </div>
      <div class="flex flex-col gap-stack-md">
        <div>
          <span class="font-mono text-xs text-ink-gray dark:text-ink-slate block mb-1">LOCATION &amp; INSTITUTION</span>
          <div class="font-sans text-sm font-semibold text-ink-black dark:text-ink-white">
            Bandar Lampung, ID (ITERA)
          </div>
        </div>
        <div>
          <span class="font-mono text-xs text-ink-gray dark:text-ink-slate block mb-1">CURRENT LOCAL TIME</span>
          <div class="font-mono text-base text-ink-black dark:text-ink-white" id="local-time">09:42 AM (WIB)</div>
        </div>
        <div>
          <span class="font-mono text-xs text-ink-gray dark:text-ink-slate block mb-1">PRIMARY CORE STACK</span>
          <div class="flex flex-wrap gap-2 mt-1">
            <span class="px-3 py-1 border border-ink-border-light dark:border-ink-border-dark rounded text-xs font-mono bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Machine Learning</span>
            <span class="px-3 py-1 border border-ink-border-light dark:border-ink-border-dark rounded text-xs font-mono bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Tableau</span>
            <span class="px-3 py-1 border border-ink-border-light dark:border-ink-border-dark rounded text-xs font-mono bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Node.js / Express</span>
            <span class="px-3 py-1 border border-ink-border-light dark:border-ink-border-dark rounded text-xs font-mono bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">PostgreSQL / SQL</span>
            <span class="px-3 py-1 border border-ink-border-light dark:border-ink-border-dark rounded text-xs font-mono bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">Python / AI</span>
            <span class="px-3 py-1 border border-ink-border-light dark:border-ink-border-dark rounded text-xs font-mono bg-surface-card-light dark:bg-surface-charcoal text-ink-gray dark:text-ink-slate">C++</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function updateTime() {
    const timeElement = document.getElementById('local-time');
    if (timeElement) {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit', hour12: true, timeZone: 'Asia/Jakarta' };
      timeElement.textContent = now.toLocaleTimeString('en-US', options) + ' (WIB)';
    }
  }
  setInterval(updateTime, 1000);
  updateTime();

  document.addEventListener('astro:after-swap', () => {
    updateTime();
  });
</script>
