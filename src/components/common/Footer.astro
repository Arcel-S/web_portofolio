---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-container-low dark:bg-surface-charcoal border-t-2 border-ink-black dark:border-ink-border-dark py-section-gap px-grid-margin relative z-10">
  <div class="max-w-7xl mx-auto flex flex-col gap-section-gap">
    
    <!-- Top Footer Bar: Brand & Mission -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-grid-margin items-start">
      <div class="md:col-span-6 flex flex-col gap-stack-sm">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-brand-terracotta border border-ink-black inline-block"></span>
          <span class="font-serif text-2xl font-bold tracking-tight text-ink-black dark:text-ink-white">
            MARCEL<span class="text-brand-terracotta">.DEV</span>
          </span>
