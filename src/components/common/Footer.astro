          <span class="text-primary font-bold uppercase tracking-wider mb-1">[ SPEC ]</span>
          <span class="text-ink-gray dark:text-ink-slate">ASTRO v4.16</span>
          <span class="text-ink-gray dark:text-ink-slate">TAILWIND CSS</span>
