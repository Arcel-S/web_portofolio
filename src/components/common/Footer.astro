          <a href="https://www.linkedin.com/in/marcelsiregar/" target="_blank" rel="noopener noreferrer" class="text-ink-gray dark:text-ink-slate hover:text-brand-terracotta transition-colors">&gt; LinkedIn ↗</a>
          <a href="mailto:marcellsiregar1204@gmail.com" class="text-ink-gray dark:text-ink-slate hover:text-brand-terracotta transition-colors">&gt; Email ↗</a>
          <a href="https://wa.me/6282169796969" target="_blank" rel="noopener noreferrer" class="text-ink-gray dark:text-ink-slate hover:text-brand-terracotta transition-colors">&gt; WhatsApp ↗</a>
